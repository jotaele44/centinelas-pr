  "policy": {"require_zero_material_residue": true, "dimensions": ["executability", "semantic", "state", "auth", "data", "provenance", "device", "identity", "geometry", "authority"]},
  "discovery": {
    "backend_roots": ["server/backend", "src/centinelas", "desktop"],
