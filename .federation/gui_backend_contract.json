    "geometry_authority": "consumer-of-spiderweb-for-federated-geometry",
    "provenance_authority": "intake-source-validation-and-handoff-provenance"
  },
  "auth": {"mutating_route_policy": "require_guard_or_explicit_public", "guard_patterns": ["Depends\\(", "require_admin", "require_write", "_WRITE_GUARD", "_require_key", "dependencies\\s*="], "explicit_public_mutations": []},
  "provenance": {"required_fields_when_available": ["source_ref", "source_hash", "evidence_ids", "truth_state", "review_status"], "frontend_evidence_files": ["frontend/src/App.jsx", "frontend/src/components/Header.jsx"]},
  "devices": {"desktop": true, "mobile_web": true, "native_ios": false, "native_evidence_files": [], "intentional_restrictions": []},
  "backend_only_allowlist": [],
  "gui_only_allowlist": [],
  "state_claims": [],
  "runtime_evidence": {
    "data": {"state": "OPEN", "evidence": []},
    "identity": {"state": "OPEN", "evidence": []},
    "geometry": {"state": "OPEN", "evidence": []},
    "device": {"state": "OPEN", "evidence": []}
  },
  "certification": {"state": "OPEN", "material_residue": ["Prove candidate→validated→handoff GUI state transitions against backend lifecycle and role enforcement."]}
}
