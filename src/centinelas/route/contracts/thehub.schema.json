{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TheHub Intake Record",
  "type": "object",
  "required": ["schema_version", "item_id", "source_url", "title", "labels", "captured_at"],
  "properties": {
    "schema_version": { "type": "string" },
    "item_id": { "type": "string" },
    "source_url": { "type": "string", "format": "uri" },
    "source_name": { "type": "string" },
    "title": { "type": "string" },
    "body_text": { "type": "string" },
    "published_at": { "type": "string", "format": "date-time" },
    "captured_at": { "type": "string", "format": "date-time" },
    "evidence_tier": { "type": "string", "enum": ["T1", "T2", "T3", "T4"] },
    "labels": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "classifier_reasoning": { "type": "string" },
    "routed_to": { "type": "string" },
    "routed_at": { "type": "string", "format": "date-time" },
    "project_lead": {
      "type": "object",
      "description": "Discovery provenance only. It cannot substitute for MoneySweep/SpiderWeb producer assertions or prove a cross-producer binding.",
      "required": ["lead_id", "origin_item_id", "identity_effect", "discovery_state"],
      "properties": {
        "lead_id": { "type": "string", "pattern": "^prjlead_[a-f0-9]{32}$" },
        "origin_item_id": { "type": "string" },
        "identity_effect": { "const": "NONE" },
        "discovery_state": { "const": "DETECTED" }
      }
    }
  }
}
