# Example environment configuration for centinelas-pr.
# Copy to `.env` and fill in only the optional values you use. NEVER commit a
# real `.env`; no production credential belongs in this repository.
#
# Python reads these values from the process environment. This repo has no
# dotenv loader, so export them explicitly when needed. VITE_* values are loaded
# by Vite for frontend development/builds.

# ── Classifier authority ─────────────────────────────────────────────────────
# Default and authoritative core path. `local` requires no SDK, account, secret,
# or network access. Set `anthropic` only after installing .[hosted-classifier].
CENTINELAS_CLASSIFIER_BACKEND=local
# Used only when CENTINELAS_CLASSIFIER_BACKEND=anthropic.
ANTHROPIC_API_KEY=

# ── Local Federation authority ───────────────────────────────────────────────
# Canonical local outbox/inbox/receipt root. Default: <CENTINELAS_DATA_DIR>/exchange
CENTINELAS_EXCHANGE_ROOT=.centinelas/exchange
# Optional hosted mirror credential used only by scripts/emit_dispatches.py.
# A mirror failure never removes or invalidates the canonical local envelope.
FEDERATION_DISPATCH_TOKEN=
# GitHub Actions may expose GITHUB_TOKEN as a fallback for an explicitly enabled
# mirror. It is not a local transport dependency or canonical identity source.
GITHUB_TOKEN=

# ── Paths and routing ────────────────────────────────────────────────────────
# Local queue/classified/dispatched directory. Default: .centinelas
CENTINELAS_DATA_DIR=
# Minimum routing confidence threshold. Default: 0.55
CENTINELAS_ROUTE_MIN_CONFIDENCE=

# ── Frontend ─────────────────────────────────────────────────────────────────
# Base URL of the local FastAPI backend. Default: http://localhost:8000
VITE_API_BASE=
VITE_CENTINELAS_APP_ID=
VITE_CENTINELAS_FUNCTIONS_VERSION=
VITE_CENTINELAS_APP_BASE_URL=
